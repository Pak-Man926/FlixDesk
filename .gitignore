# ==========================================
# FlixDesk - .gitignore
# ==========================================

# 1. Python Artifacts & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 2. Flatpak & Packaging Build Directories
build-dir/
.flatpak-builder/
repo/
*.flatpak
*.AppImage
*.deb
*.rpm
*.tar.gz
*.tar.xz
*.tar.zst
*.zip
chrome-extract/
google-chrome-stable*.deb

# 3. Node & Electron Artifacts (Legacy/Dev)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Local User Data & Caches
*.log
.cache/
.config/
qt_profile/
chrome_profile/

# 5. IDE & Operating System Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*~
